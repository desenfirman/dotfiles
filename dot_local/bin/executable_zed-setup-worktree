#!/usr/bin/env bash
# Symlink shared env dirs/files from the main git worktree into a new worktree.
# Used by Zed's `create_worktree` task hook. Runs as a script (no -c), so
# quoting is safe regardless of which shell Zed spawns.
set -euo pipefail

main_root="${ZED_MAIN_GIT_WORKTREE:?ZED_MAIN_GIT_WORKTREE not set}"
wt_root="${ZED_WORKTREE_ROOT:?ZED_WORKTREE_ROOT not set}"

for name in .venv .env; do
    if [ -e "$main_root/$name" ]; then
        ln -sfn "$main_root/$name" "$wt_root/$name"
        echo "linked $name -> $main_root/$name"
    else
        echo "skipped $name (absent in main worktree)"
    fi
done
